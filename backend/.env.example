# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/veil-and-vogue

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# Public/backend base URL (recommended for production/live URLs)
# PUBLIC_BASE_URL=https://your-backend-domain.com
# BACKEND_URL=https://your-backend-domain.com

# Upload storage (local by default). For Cloudinary, set UPLOAD_PROVIDER=cloudinary and add keys below.
# UPLOAD_PROVIDER=local
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
EMAIL_FROM="Veil & Vogue <no-reply@example.com>"
